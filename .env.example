# Payload (обязательно: длинная случайная строка)
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Тот же PAYLOAD_SECRET добавьте в GitHub → Settings → Secrets → Actions как PAYLOAD_SECRET
# (нужен для `npm run build` в CI при деплое).

# SQLite — источник правды для контента Payload (в git не коммитится).
# Можно вынести за пределы каталога деплоя, например:
# DATABASE_URL=file:/var/lib/sevcrf/payload.sqlite
DATABASE_URL=file:./payload.sqlite

# Перенос «Payload с собой»: архив БД + загрузок
#   npm run payload:backup
# На новой машине после клона репозитория скопируйте .tar.gz в проект и:
#   npm run payload:restore -- backups/payload-bundle-....tar.gz
# (нужны те же PAYLOAD_SECRET и путь к БД, что при создании архива.)

# Опционально: первичное наполнение из статических файлов (пустая БД; нужен src/data)
#   npm run seed:cms
# Не используйте --force на проде. Дубликаты public/gallery, public/sgfr и т.д. из репо удалены.
# Проверка лишних файлов в public/media: npm run payload:orphans

